# Payer/deployer — must hold PHRS on Atlantic (verify: npm run check:balance)
PRIVATE_KEY=0x
# Payee — needs PHRS for claim gas; seed tops up 0.01 PHRS if low
AGENT_B_PRIVATE_KEY=0x
PHAROS_RPC_URL=https://atlantic.dplabs-internal.com
# Spacing between RPC calls (ms) — avoids Atlantic / zan.top CU rate limits
RPC_MIN_INTERVAL_MS=250
# Backoff base when rate-limited (ms)
RPC_RETRY_MS=2000
# Batch demos: BATCH_SIZE=5, BATCH_MODE=saliFast|hybridWork
PROVE_TIER=receipt
